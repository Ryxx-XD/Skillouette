# ==============================================================================
# Skillouette Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Server Runtime
PORT=3001
NODE_ENV=development

# Supabase Persistence & Authentication
# Required for cloud PostgreSQL database and user authentication.
# If omitted or offline, Skillouette gracefully falls back to local resilient storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
# Server-only service role key. NEVER expose in client bundles!
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key-here

# AI Model Provider Credentials
# Skillouette uses Gemini by default, or OpenAI if configured.
# If no key is configured, Skillouette automatically runs rule-based grounded heuristic intelligence.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Cloudflare Deployment & Observability
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CF_PAGES_URL=https://skillouette.pages.dev
